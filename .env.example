# Understudy Environment Configuration Template
# Copy this file to .env and supply your secrets. Never commit .env.

# LLM Reasoning & Embeddings (OpenRouter, model-agnostic)
OPENROUTER_API_KEY=sk-or-...
UNDERSTUDY_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
UNDERSTUDY_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Incident Management (PagerDuty) - PAGERDUTY_ROUTING_KEY and PAGERDUTY_WEBHOOK_SECRET required
PAGERDUTY_ROUTING_KEY=pd_routing_key_...
PAGERDUTY_WEBHOOK_SECRET=pd_secret_...
PAGERDUTY_TOKEN=u+...
PAGERDUTY_SERVICE_ID=PXXXXXX

# Communication (Slack)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789

# Version Control & Deploy History (GitHub)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=Harikeshav-R/Understudy

# Observability (Optional Free-tier Datadog Mirror)
DATADOG_API_KEY=

# Local Runtime Configuration
UNDERSTUDY_ENV=development
UNDERSTUDY_LOG_LEVEL=INFO
